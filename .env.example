# =============================================================================
# Postmon - Configuracao de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores apropriados

# -----------------------------------------------------------------------------
# MongoDB - Configuracao do banco de dados
# -----------------------------------------------------------------------------
POSTMON_DB_HOST=localhost
POSTMON_DB_PORT=27017
POSTMON_DB_NAME=postmon
# Credenciais (opcional - deixe em branco para conexao sem autenticacao)
POSTMON_DB_USER=
POSTMON_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Google Maps Geocoding API
# -----------------------------------------------------------------------------
# Obtenha sua chave em: https://console.cloud.google.com/apis/credentials
# Habilite a Geocoding API em: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Geocodificacao - Configuracoes opcionais
# -----------------------------------------------------------------------------
# Numero de CEPs a geocodificar por batch (default: 100)
GEOCODING_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# Sentry - Monitoramento de erros (opcional)
# -----------------------------------------------------------------------------
# DSN do Sentry para rastreamento de erros em producao
# Obtenha em: https://sentry.io/
SENTRY_DSN=
